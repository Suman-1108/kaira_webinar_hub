# =================================================================
# KAIRA WEBINAR HUB - BACKEND ENVIRONMENT SPECIFICATION (.env.example)
# =================================================================

# Server & URLs
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:5001

# Database Configuration (MongoDB Atlas or Local Instance)
MONGODB_URI=mongodb://127.0.0.1:27017/kaira_webinar_hub

# Security & Authentication
JWT_SECRET=kaira_webinar_hub_super_secret_jwt_key_2026
SESSION_SECRET=kaira_session_secret_change_in_production

# Razorpay Online Payment Gateway Integration
# (Get credentials from https://dashboard.razorpay.com/#/access/api-keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PhonePe PG v2 Standard Checkout Integration (@phonepe-pg/pg-sdk-node)
# (Get from PhonePe Business Dashboard -> Developer Settings -> API Keys)
PHONEPE_CLIENT_ID=SU2604151549453655316895
PHONEPE_CLIENT_SECRET=your_rotated_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=M234DRGMCCPVC
PHONEPE_ENV=SANDBOX
BACKEND_URL=http://localhost:5001

# Transactional Email (SMTP Credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_or_smtp_user@example.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Kaira Webinar Hub <support@kairawebinarhub.com>

# Meta WhatsApp Cloud API Integration
# (Get from Meta for Developers -> WhatsApp -> API Setup)
META_WHATSAPP_TOKEN=your_meta_system_user_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
META_WHATSAPP_VERIFY_TOKEN=kaira_webinar_hub_wa_verify_2026
META_APP_SECRET=your_meta_app_secret

# Logging & Storage
LOG_LEVEL=info
