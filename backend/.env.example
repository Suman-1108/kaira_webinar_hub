# =================================================================
# KAIRA WEBINAR HUB - BACKEND ENVIRONMENT SPECIFICATION (.env.example)
# =================================================================

# Server & Network Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Database Configuration (Switch Model)
# Set DB_MODE to 'local' for local MongoDB or 'atlas' for MongoDB Atlas Cloud
DB_MODE=local
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/kaira_webinar_hub
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-host>/kaira_webinar_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kaira_webinar_hub

# Security & Authentication (JWT & Session)
JWT_SECRET=your_jwt_secret_key_min_32_characters
SESSION_SECRET=your_session_secret_change_in_production

# PhonePe PG v2 Standard Checkout Integration (@phonepe-pg/pg-sdk-node)
# (Obtain from PhonePe Merchant Portal -> Developer Settings -> API Keys)
# Note: PHONEPE_ENV must match the credentials mode: SANDBOX or PRODUCTION
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_ENV=PRODUCTION

# Transactional Email Service (Gmail / SMTP Credentials for OTP & Invoices)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_email@example.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=Kaira Webinar Hub <your_smtp_email@example.com>

# Logging
LOG_LEVEL=info
